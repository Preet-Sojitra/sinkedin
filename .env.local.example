# Supabase Configuration
# Get these from your Supabase project dashboard or from 'supabase start' output

# For LOCAL development with Supabase CLI (Recommended):
# Run: supabase start
# Then copy the values shown in the terminal output
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key-from-supabase-start"

# For CLOUD Supabase (Alternative):
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-cloud-anon-key"

# App Configuration
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional: Google OAuth (only if you want to test Google sign-in)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="your-google-client-id"
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# Storage (only needed for cloud Supabase)
# SUPABASE_AVATARS_URL="https://your-project-id.supabase.co/storage/v1/object/public/avatars"
